terraform {
  required_version = ">= 1.8"

  required_providers {
    hubspot = {
      source  = "__PROVIDER_SOURCE__"
      version = "__PROVIDER_VERSION__"
    }
  }
}

variable "hubspot_access_token" {
  type        = string
  description = "Access token for the isolated released-provider journey."
  sensitive   = true
  nullable    = false
}

variable "acceptance_prefix" {
  type        = string
  description = "Unique prefix owned by this released-provider journey."
  nullable    = false

  validation {
    condition     = can(regex("^tf_acc_[A-Za-z0-9_]+_$", var.acceptance_prefix))
    error_message = "acceptance_prefix must start with tf_acc_ and end with an underscore."
  }
}

variable "presentation" {
  type        = string
  description = "Named presentation phase used to prove updates under both engines."
  nullable    = false

  validation {
    condition     = contains(["initial", "terraform", "tofu", "terraform_final"], var.presentation)
    error_message = "presentation must be one of the released journey phases."
  }
}

provider "hubspot" {
  access_token = var.hubspot_access_token
}

resource "hubspot_form_definition" "released" {
  name = "${var.acceptance_prefix}released_form"

  field_groups = [{
    fields = [{
      label                  = var.presentation == "initial" ? "Email address" : "Work email"
      description            = var.presentation == "tofu" ? "OpenTofu-managed contact email" : "Released provider contact email"
      placeholder            = var.presentation == "terraform_final" ? "final@example.com" : "name@example.com"
      required               = var.presentation != "tofu"
      blocked_email_domains  = var.presentation == "terraform" ? ["example.com"] : []
      use_default_block_list = var.presentation != "terraform"
    }]
  }]

  configuration = {
    language                         = "en"
    allow_link_to_reset_known_values = var.presentation == "tofu"
    pre_populate_known_values        = var.presentation == "terraform_final"
    recaptcha_enabled                = var.presentation != "tofu"
    thank_you_text                   = var.presentation == "initial" ? "Thank you" : "Thank you for contacting us"
  }

  display_options = {
    submit_button_text = var.presentation == "initial" ? "Submit" : "Contact us"
    style = {
      label_text_size          = "13px"
      label_text_color         = "#33475b"
      legal_consent_text_size  = "12px"
      legal_consent_text_color = "#33475b"
      help_text_size           = "11px"
      help_text_color          = "#516f90"
      font_family              = "Arial, sans-serif"
      background_width         = var.presentation == "tofu" ? "95%" : "100%"
      submit_font_color        = "#ffffff"
      submit_alignment         = var.presentation == "terraform_final" ? "center" : "left"
      submit_size              = "12px 24px"
      submit_color             = var.presentation == "initial" ? "#ff7a59" : "#00a4bd"
    }
  }
}

output "released_form_id" {
  description = "Exact generated identity used across both registry sources."
  value       = hubspot_form_definition.released.id
}
